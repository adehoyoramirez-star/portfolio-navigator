// ============================================================
// OLYMPUS TACTICAL MOTOR — Pine Script v8 REFUERZOS BRUTALES
// Copia este codigo entero en TradingView Pine Editor
// ============================================================
//@version=6
indicator("Olympus Tactical Motor v8", overlay=true, max_lines_count=12, max_labels_count=50)

// INPUTS
show_blood     = input.bool(true,  "BLOOD IN STREETS",    group="SENALES")
show_mean      = input.bool(true,  "MEAN REVERSION",      group="SENALES")
show_momentum  = input.bool(true,  "MOMENTUM BREAKOUT",   group="SENALES")
show_oversold  = input.bool(true,  "OVERSOLD BOUNCE",     group="SENALES")
show_sector    = input.bool(true,  "SECTOR ROTATION",     group="SENALES")
show_stops     = input.bool(true,  "Mostrar Stop Loss/TPs", group="NIVELES")
show_entry     = input.bool(true,  "Zona entrada RSI(2)", group="NIVELES")
min_exec_score = input.int(55, "Execution Score minimo", 0, 100, group="FILTROS")

// REGIMEN FILTER
spy_sym    = input.symbol("SPY", "Benchmark SPY", group="REGIMEN")
vix_sym    = input.symbol("VIX", "VIX", group="REGIMEN")
show_regime = input.bool(true, "Mostrar regimen", group="REGIMEN")

spy_close    = request.security(spy_sym, timeframe.period, close)
spy_close20  = request.security(spy_sym, timeframe.period, close[20])
spy_close50  = request.security(spy_sym, timeframe.period, close[50])
spy_ma200    = request.security(spy_sym, timeframe.period, ta.sma(close, 200))
spy_ma50     = request.security(spy_sym, timeframe.period, ta.sma(close, 50))
vix_close    = request.security(vix_sym, timeframe.period, close)

spy_net_move = math.abs(spy_close - spy_close50)
spy_path_sum = 0.0
if bar_index >= 50
    for i = 0 to 49
        spy_c1 = request.security(spy_sym, timeframe.period, close[i])
        spy_c2 = request.security(spy_sym, timeframe.period, close[i+1])
        spy_path_sum := spy_path_sum + math.abs(spy_c1 - spy_c2)
spy_er = spy_path_sum > 0 ? spy_net_move / spy_path_sum : 0
spy_mom4w = spy_close20 > 0 ? (spy_close / spy_close20) - 1 : 0
spy_above_ma200 = spy_close > spy_ma200
spy_above_ma50  = spy_close > spy_ma50

var string market_regime = "RANGING"
var float  regime_size_mult = 0.8

if barstate.islast
    if vix_close > 35
        market_regime      := "CRASH"
        regime_size_mult   := 0.3
    else if not spy_above_ma200 and spy_mom4w < -0.05
        market_regime      := "TRENDING_DOWN"
        regime_size_mult   := 0.5
    else if spy_above_ma200 and spy_above_ma50 and spy_mom4w > 0.02 and spy_er > 0.40
        market_regime      := "TRENDING_UP"
        regime_size_mult   := 1.0
    else
        market_regime      := "RANGING"
        regime_size_mult   := 0.8

// STRENGTH VS SECTOR
sector_etf = input.symbol("XLK", "Sector ETF referencia", group="VS SECTOR", tooltip="XLK=Tech XLF=Finance XLE=Energy XLV=Health")

sector_close    = request.security(sector_etf, timeframe.period, close)
sector_close126 = request.security(sector_etf, timeframe.period, close[126])
rs_vs_sector = (close[126] > 0 and sector_close126 > 0) ?
     (close / close[126]) / (sector_close / sector_close126) : 1.0

// RS HARD FILTER
rs_vs_spy = (close[252] > 0 and spy_close[252] > 0) ?
     (close / close[252]) / (spy_close / spy_close[252]) : 1.0
min_rs_spy    = 0.85
min_rs_sector = 0.90
passes_rs_spy    = rs_vs_spy >= min_rs_spy
passes_rs_sector = rs_vs_sector >= min_rs_sector

// INDICADORES BASE
ma20   = ta.sma(close, 20)
ma50   = ta.sma(close, 50)
ma200  = ta.sma(close, 200)
rsi2   = ta.rsi(close, 2)
rsi14  = ta.rsi(close, 14)
[bbMiddle, bbUpper, bbLower] = ta.bb(close, 20, 2)
sd20     = ta.stdev(close, 20)
zScore20 = sd20 > 0 ? (close - ma20) / sd20 : 0
sd50     = ta.stdev(close, 50)
zScore50 = sd50 > 0 ? (close - ta.sma(close, 50)) / sd50 : 0
atr14  = ta.atr(14)
atrPct = close > 0 ? atr14 / close : 0.02

netMove   = math.abs(close - close[20])
totalPath = 0.0
for i = 1 to 20
    totalPath += math.abs(close[i-1] - close[i])
er  = totalPath > 0 ? netMove / totalPath : 0
adx = er * 100

volAvg20 = ta.sma(volume, 20)
volRatio = volAvg20 > 0 ? volume / volAvg20 : 1.0
high52w      = ta.highest(close, 252)
drawdown52w  = high52w > 0 ? (close / high52w) - 1 : 0
aboveMA200 = close > ma200
aboveMA50  = close > ma50
trend_up   = close > ma50 and ma50 > ma200
trend_down = close < ma50 and ma50 < ma200
[macdLine, macdSignal, macdHist] = ta.macd(close, 12, 26, 9)

// SENALES
inExtremeCrash  = drawdown52w < -0.35
blood_active    = rsi2 < 10 and zScore20 < -1.5 and (aboveMA200 or inExtremeCrash)
blood_score_raw = blood_active ? math.min(100, 45 + (10 - math.min(10, rsi2)) * 4 + (math.abs(zScore20) - 1.5) * 5 + (volRatio > 1.5 ? 8 : 0) + (aboveMA200 ? 0 : -15)) : 0

mean_active    = rsi2 < 15 and close < bbLower * 1.02
mean_score_raw = mean_active ? math.min(100, 40 + (15 - math.min(15, rsi2)) * 2 + (close < bbLower ? 12 : 4) + (zScore20 < -1.5 ? 8 : 0)) : 0

mom_active    = adx > 30 and close > bbUpper * 0.995 and aboveMA50
mom_score_raw = mom_active ? math.min(100, 45 + math.min(20, (adx - 30) * 1.2) + (volRatio > 1.5 ? 20 : 0) + (close > bbUpper ? 15 : 5)) : 0

ov_active    = rsi14 < 35 and (aboveMA200 or close > ma50 * 0.95)
ov_score_raw = ov_active ? math.min(100, 42 + (35 - math.min(35, rsi14)) * 1.8 + (aboveMA200 ? 18 : 6) + (zScore50 < -1 ? 8 : 0)) : 0

sec_active    = drawdown52w < -0.20 and rsi14 > 40 and rsi14 < 55 and (aboveMA200 or aboveMA50)
sec_score_raw = sec_active ? math.min(100, 40 + math.min(25, (math.abs(drawdown52w) - 0.20) * 100) + (aboveMA200 ? 20 : 5) + 15) : 0

// EXHAUSTION DETECTION
price_near_resistance = bbUpper > 0 and close / bbUpper > 0.98
vol_declining_3bars = volume < volume[1] and volume[1] < volume[2] and volume[2] < volume[3]
weak_rally = (close > close[1] or close[1] > close[2]) and vol_declining_3bars
rsi_overbought = rsi14 > 75
rsi_stretched  = rsi14 > 70
macd_weakening = macdHist > 0 and macdHist < macdHist[1] and macdHist < 0.5
price_stalling = math.abs(close - close[2]) / close < 0.005 and math.abs(close - close[1]) / close < 0.003

exhaustion_confidence = 0
if price_near_resistance
    exhaustion_confidence := exhaustion_confidence + 25
if weak_rally
    exhaustion_confidence := exhaustion_confidence + 20
if rsi_overbought
    exhaustion_confidence := exhaustion_confidence + 25
else if rsi_stretched and (bbUpper > 0 and close / bbUpper > 0.95)
    exhaustion_confidence := exhaustion_confidence + 20
if price_stalling
    exhaustion_confidence := exhaustion_confidence + 20
if macd_weakening
    exhaustion_confidence := exhaustion_confidence + 10
rally_exhausted = exhaustion_confidence >= 40

// TOTAL SCORE
w_blood=1.0; w_mom=0.8; w_mean=0.7; w_oversold=0.5; w_sector=0.4
weighted_sum=0.0; total_weight=0.0; n_active=0

if blood_active
    weighted_sum:=weighted_sum+blood_score_raw*w_blood; total_weight:=total_weight+w_blood; n_active:=n_active+1
if mom_active
    weighted_sum:=weighted_sum+mom_score_raw*w_mom; total_weight:=total_weight+w_mom; n_active:=n_active+1
if mean_active
    weighted_sum:=weighted_sum+mean_score_raw*w_mean; total_weight:=total_weight+w_mean; n_active:=n_active+1
if ov_active
    weighted_sum:=weighted_sum+ov_score_raw*w_oversold; total_weight:=total_weight+w_oversold; n_active:=n_active+1
if sec_active
    weighted_sum:=weighted_sum+sec_score_raw*w_sector; total_weight:=total_weight+w_sector; n_active:=n_active+1

opportunity_score = math.min(100, math.round(total_weight > 0 ? weighted_sum / total_weight : 0) + (n_active >= 3 ? 10 : n_active == 2 ? 5 : 0))

// QUALITY SCORE
q_rs = rs_vs_spy > 1.15 ? 35 : rs_vs_spy > 1.05 ? 25 : rs_vs_spy > 0.95 ? 15 : rs_vs_spy > 0.85 ? 5 : 0
q_vol = volRatio > 2.0 ? 20 : volRatio > 1.5 ? 15 : volRatio > 1.0 ? 10 : volRatio >= 0.5 ? 5 : 0
q_trend = trend_up ? 25 : (not trend_down and not trend_up) ? 10 : 0
q_atr = atrPct < 0.03 ? 20 : atrPct < 0.05 ? 15 : atrPct < 0.08 ? 8 : 0
quality_score = math.min(100, q_rs + q_vol + q_trend + q_atr)

// EXECUTION SCORE
execution_score = math.min(100, math.round(opportunity_score * 0.6 + quality_score * 0.4))

// TIPO DE SENAL ACTIVA
signal_type = bl
