{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],

    "module": "ESNext",
    "moduleResolution": "bundler",

    "jsx": "react-jsx",

    "noEmit": true,
    "isolatedModules": true,

    "strict": true,
    "noImplicitAny": true,

    "skipLibCheck": true,

    "types": ["node"],

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src", "pages", "api"],
  "exclude": ["node_modules"]
}