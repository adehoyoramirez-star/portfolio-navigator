function synOHLC(cs){const H=[],L=[],O=[];for(let i=0;i<cs.length;i++){const p=i>0?cs[i-1]:cs[i];const r=Math.abs((cs[i]-p)/Math.max(p,0.01));const tk=0.003+r*1.2;H.push(cs[i]*(1+tk*0.5));L.push(cs[i]*(1-tk*0.5));O.push(p);}return{H,L,O};}
function lzScr(cs,hs,ls,i,ca){if(i<40)return 0;const cR=ca.rsi14[i],cS=ca.sl30[i],cA=ca.adx14[i],cT=ca.atr14[i]/Math.max(cs[i],0.01);const D=[];for(let j=i-P.lzLB;j<i-5;j++){if(j<30)continue;const mR=ca.rsi14[j],mS=ca.sl30[j],mA=ca.adx14[j],mT=ca.atr14[j]/Math.max(cs[j],0.01);const d=Math.log(1+Math.abs(cR-mR))+Math.log(1+Math.abs(cS-mS)*100)+Math.log(1+Math.abs(cA-mA))+Math.log(1+Math.abs(cT-mT)*100);if(j+4<cs.length)D.push({d,y:cs[j+4]-cs[j]});}if(D.length<P.lzK)return 0;D.sort((a,b)=>a.d-b.d);let b=0;for(let n=0;n<P.lzK;n++)if(D[n].y>0)b++;return b-(P.lzK-b);}
function gates(cs,hs,ls,os,i,ca){const e50=ca.ema50[i],e200=ca.ema200[i];const gR=e50>e200?1:0;const sl=ca.sl120[i];const mid=cs[i]+sl*60;let sd=0;for(let j=i-P.regL+1;j<=i;j++)sd+=(cs[j]-mid)*(cs[j]-mid);sd=Math.sqrt(sd/P.regL);const pos=(cs[i]-(mid-sd*2))/Math.max(0.001,sd*4);const gC=(pos>=0.25&&pos<=0.75)?1:0;const r2=ca.rsi2[i];const gRsi=(r2<20||r2>80)?1:0;const a14=ca.adx14[i];const gA=(a14>=P.adxT&&a14<=P.adxC)?1:0;const gLtf=cs[i]>e50?1:0;const gHtf=cs[i]>e200?1:0;const ch=Math.max(0.001,hs[i]-ls[i]);const gStr=(cs[i]-ls[i])/ch>=0.5?1:0;const body=Math.abs(cs[i]-os[i]);const wmax=Math.max(hs[i]-Math.max(cs[i],os[i]),Math.min(cs[i],os[i])-ls[i]);const gW=(wmax/ch)>=0.4&&body<ch*0.5?1:0;const rt=Math.abs((cs[i]-cs[i-1])/Math.max(cs[i-1],0.01));let sr=0;for(let j=i-P.volL+1;j<=i;j++)sr+=Math.abs((cs[j]-cs[j-1])/Math.max(cs[j-1],0.01));const ar=sr/P.volL;const gFl=rt>ar*1.5?1:0;const G=[gR,gC,gRsi,gA,gLtf,gHtf,gStr,gW,gFl];const cnt=G.reduce((a,b)=>a+b,0);const scr=gR*16+gC*10+gRsi*12+gA*12+gLtf*8+gHtf*12+gStr*8+gW*10+gFl*12;return{count:cnt,score:scr,rsi2:r2};}
