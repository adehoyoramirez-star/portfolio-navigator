function shouldEnt(g,lz,side){if(side==="LONG"){return{strict:g.count>=P.strictG&&g.score>=P.strictS&&g.rsi2<30,hybrid:(g.count>=P.strictG&&g.score>=P.strictS&&g.rsi2<30)||(lz>=P.lzMin&&g.count>=P.hybG&&g.score>=P.hybS)};}else{return{strict:g.count>=P.strictG&&g.score>=P.strictS&&g.rsi2>70,hybrid:(g.count>=P.strictG&&g.score>=P.strictS&&g.rsi2>70)||(lz<=-P.lzMin&&g.count>=P.hybG&&g.score>=P.hybS)};}}
function simTr(cs,hs,ls,os,i,side){const e=cs[i];const a=atr(hs,ls,cs,i,14);if(a<=0)return null;const slD=a*P.slM,tpD=slD*P.tp1RR;let sl,tp;if(side==="LONG"){sl=e-slD;tp=e+tpD;}else{sl=e+slD;tp=e-tpD;}let xp=e,exd=i+P.mxH,re="TIMEOUT",hit=false;for(let k=1;k<=P.mxH&&i+k<cs.length;k++){const idx=i+k;if(side==="LONG"){if(ls[idx]<=sl){xp=sl;exd=idx;re="SL";break;}if(hs[idx]>=tp&&!hit)hit=true;if(hit){let hw=e;for(let w=i+1;w<=idx;w++)if(hs[w]>hw)hw=hs[w];if(ls[idx]<=hw-a*P.trM&&k>1){xp=hw-a*P.trM;exd=idx;re="TRAIL";break;}}if(k===P.mxH){xp=cs[Math.min(idx,cs.length-1)];exd=idx;re=hit?"TRAIL_END":"TIMEOUT";}}else{if(hs[idx]>=sl){xp=sl;exd=idx;re="SL";break;}if(ls[idx]<=tp&&!hit)hit=true;if(hit){let lw=e;for(let w=i+1;w<=idx;w++)if(ls[w]<lw)lw=ls[w];if(hs[idx]>=lw+a*P.trM&&k>1){xp=lw+a*P.trM;exd=idx;re="TRAIL";break;}}if(k===P.mxH){xp=cs[Math.min(idx,cs.length-1)];exd=idx;re=hit?"TRAIL_END":"TIMEOUT";}}}const p=(xp-e)/e*(side==="LONG"?1:-1);return{entry:e,exit:xp,side,R:p/(slD/e),days:exd-i,reason:re};}
const cp=path.join(__dirname,"historical_data_daily.csv");const csv=fs.readFileSync(cp,"utf8");const ls=csv.split("\n").filter(l=>l.trim().length>0);const hdr=ls[0].split(",").map(s=>s.trim());const cols={};hdr.forEach((h,i)=>cols[h]=i);const IDX=cols["XNAS.DE"];
const allR=ls.slice(1).map(l=>({date:l.split(",")[0],close:parseFloat(l.split(",")[IDX])})).filter(r=>r.date&&!isNaN(r.close));
const dR=allR.slice(-126);const dates=dR.map(r=>r.date);let cs=dR.map(r=>r.close);for(let i=1;i<cs.length;i++){if(Math.abs(cs[i]-cs[i-1])/cs[i-1]>0.20)cs[i]=cs[i-1];}const{H,L,O}=synOHLC(cs);
console.log("OLYMPUS HMR v3.5 BACKTEST");console.log("Asset: XNAS.DE (Nasdaq-100 ~ QQQ proxy)");console.log("Period:",dates[0],"->",dates[dates.length-1],"("+cs.length+" days, "+(cs.length/21).toFixed(1)+" months)");console.log("Price: "+cs[0].toFixed(2)+" -> "+cs[cs.length-1].toFixed(2));
const ca={ema50:[],ema200:[],rsi2:[],rsi14:[],adx14:[],atr14:[],sl30:[],sl120:[]};for(let i=0;i<cs.length;i++){ca.ema50[i]=ema(cs,50,i);ca.ema200[i]=ema(cs,200,i);ca.rsi2[i]=rsi(cs,2,i);ca.rsi14[i]=rsi(cs,14,i);ca.adx14[i]=adx(H,L,cs,i,14);ca.atr14[i]=atr(H,L,cs,i,14);ca.sl30[i]=linSl(cs,30,i);ca.sl120[i]=linSl(cs,120,i);}
const tr={STRICT:[],HYBRID:[]};for(let i=40;i<cs.length-P.mxH-1;i++){const g=gates(cs,H,L,O,i,ca);const lz=lzScr(cs,H,L,i,ca);const le=shouldEnt(g,lz,"LONG");const se=shouldEnt(g,lz,"SHORT");if(le.strict){const t=simTr(cs,H,L,O,i,"LONG");if(t)tr.STRICT.push(Object.assign({},t,{date:dates[i]}));}if(se.strict){const t=simTr(cs,H,L,O,i,"SHORT");if(t)tr.STRICT.push(Object.assign({},t,{date:dates[i]}));}if(le.hybrid){const t=simTr(cs,H,L,O,i,"LONG");if(t)tr.HYBRID.push(Object.assign({},t,{date:dates[i]}));}if(se.hybrid){const t=simTr(cs,H,L,O,i,"SHORT");if(t)tr.HYBRID.push(Object.assign({},t,{date:dates[i]}));}}
function metrics(arr){const w=arr.filter(t=>t.R>0).length;const tot=arr.reduce((a,t)=>a+t.R,0);const mo=cs.length/21;return{count:arr.length,wins:w,losses:arr.length-w,wr:arr.length?w/arr.length:0,avgR:arr.length?tot/arr.length:0,totalR:tot,tpm:arr.length/mo};}
const m={STRICT:metrics(tr.STRICT),HYBRID:metrics(tr.HYBRID)};
console.log("\n===== COMPARISON =====");console.log("Mode    | Trades |  W/L   |   WR   | AvgR  | TotalR | Trades/Mo");console.log("--------|--------|--------|--------|-------|--------|----------");["STRICT","HYBRID"].forEach(mode=>{const x=m[mode];console.log(mode.padEnd(7)+" | "+String(x.count).padStart(6)+" | "+(String(x.wins)+"/"+String(x.losses)).padStart(6)+" | "+(x.wr*100).toFixed(1).padStart(5)+"% | "+x.avgR.toFixed(2).padStart(5)+" | "+x.totalR.toFixed(1).padStart(6)+" | "+x.tpm.toFixed(1).padStart(5));});
console.log("\n===== TRADE DETAIL =====");["STRICT","HYBRID"].forEach(mode=>{console.log("\n--- "+mode+" ("+tr[mode].length+" trades) ---");console.log("Date   Side  Entry  Exit   R      Days  Reason");tr[mode].forEach(t=>console.log(t.date+"  "+t.side.padEnd(5)+"  "+t.entry.toFixed(2).padStart(6)+"  "+t.exit.toFixed(2).padStart(6)+"  "+t.R.toFixed(2).padStart(6)+"  "+String(t.days).padStart(3)+"   "+t.reason));});
const ratio=m.STRICT.count>0?(m.HYBRID.count/m.STRICT.count):0;console.log("\n===== VERDICT =====");console.log("HYBRID/STRICT ratio = "+ratio.toFixed(2)+"x  (target 2-3x)");console.log("HYBRID WR           = "+(m.HYBRID.wr*100).toFixed(1)+"%  (target >=55%)");console.log("HYBRID AvgR         = "+m.HYBRID.avgR.toFixed(2)+"  STRICT AvgR = "+m.STRICT.avgR.toFixed(2));console.log("Verdict: "+((ratio>=2.0&&m.HYBRID.wr>=0.55&&m.HYBRID.avgR>0)?"CUMPLIDA":"NO CUMPLIDA"));
