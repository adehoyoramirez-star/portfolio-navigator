+const wlgPeAt = new Map(wlgPeRows.map(r => [r.d, r]));
+// regimeShiftPE: si no se deriva el régimen (opción ii), queda 0 y se acota
+// la sensibilidad corriendo ±1.5 aparte.
+const WLG_REGIME_SHIFT = Number(process.env.WLG_REGIME_SHIFT ?? "0");
