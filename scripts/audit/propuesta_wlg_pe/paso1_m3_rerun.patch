+const WLG_PE_MODE = (process.env.WLG_PE_MODE ?? "A") as "A" | "B" | "C";
+const WLG_PE_CSV  = process.env.WLG_PE_CSV ?? `${DATA}/wlg_forward_pe.csv`;
